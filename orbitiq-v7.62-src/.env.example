# ─── OrbitIQ Environment Variables ───────────────────────────────────────────
# Copy to .env.local and fill in values. Never commit .env.local to git.

# ── Database (Neon via Vercel Integration) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/orbitiq?sslmode=require"

# ── Data APIs ──────────────────────────────────────────────────────────────────
SEMRUSH_API_KEY=""
SERP_API_KEY=""
PROFOUND_API_KEY=""
PROFOUND_BASE_URL="https://api.profound.io/v1"

# ── AI (Anthropic) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Storage (Vercel Blob) ──────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
